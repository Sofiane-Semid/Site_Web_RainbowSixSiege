@model Tp2ProgWeb.Models.Enfant

@{
    ViewData["Title"] = "Delete";
    Layout = "_Layout";
}



<h1>Supprimer un enfant</h1>

<h3>Êtes-vous certain(e) de vouloir supprimer cet enfant ?</h3>

<div>
    <h4>Informations de l'enfant</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.ImageEnfant)
        </dt>
        <dd class="col-sm-10 ">
            <img src="@Html.DisplayFor(model => model.ImageEnfant)" alt=" @Html.DisplayFor(model => model.Nom)" height="220" />
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Nom)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Nom)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Id)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Id)
        </dd>

    </dl>

    <form asp-action="Supprimer">
        <input type="submit" value="Supprimer" class="btn btn-danger" />
    </form>
</div>
