@model Tp2ProgWeb.Models.Enfant
@{ 
    
}
	<div class="GrosConteneur">
		<h1 style="color: black;">Détail du personnage</h1>
		<div class="row align-items-center">

			<div class="col-md-4">
				<img src="/@Model.ImageEnfant" id="AgentFavoris" alt="@Model.Nom">
			</div>

			<div class="col-md-8">
				<p><strong>Nom :</strong> @Model.Nom</p>
				<p><strong>Âge :</strong> @Model.Âge </p>
				<p><strong>Clan :</strong> @Model.Clan</p>
				<p><strong>Niveau de difficulté :</strong> @Model.NiveauDeDifficultés</p>
				<p><strong>Abilité :</strong> @Model.Abilité</p>
				<p><strong>Fonction :</strong> @Model.Fonction</p>
			</div>

			<div>
				<div class="carre mt-3">
					<strong>OPÉRATEUR FAVORI !</strong>
				</div>

				<div>
				<form asp-controller="Favoris" asp-action="AjouterUnEnfant" method="post">
						<input type="hidden" name="id" value="@Model.Id">
						<button type="submit" class="btn btn-primary mt-2">Favoris <i class="fa-solid fa-plus"></i></button>
					</form>
				</div>
				<div class="mt-4">
                    <h3>Description</h3>
                    <p><strong>@Model.Description
                        </strong>
                    </p>
                </div>
				
			</div>
		</div>
	</div>
	 <!-- Fin du contenu -->
 <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

